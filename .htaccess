Options -MultiViews
DirectorySlash Off
RewriteEngine On

# Legal pages — internal rewrite to .html files (no directory redirect)
RewriteRule ^upgr/(politiquedecookies|confidentialite|mentionslegales|cgu|cgv)$ upgr/$1.html [L]

# Eugene SEO pre-render
RewriteRule ^eugene$ eugene.html [QSA,L]

# Masterclass pages
RewriteRule ^masterclass1$ upgr/vente-masterclass1.html [QSA,L]
RewriteRule ^masterclass2$ upgr/vente-masterclass2.html [QSA,L]
RewriteRule ^pack-masterclasses$ upgr/vente-pack-masterclasses.html [QSA,L]
RewriteRule ^extrait-masterclass2$ upgr/extrait-masterclass2.html [QSA,L]
RewriteRule ^extrait-masterclass1$ upgr/extrait-masterclass1.html [QSA,L]

# SPA fallback for everything else
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

