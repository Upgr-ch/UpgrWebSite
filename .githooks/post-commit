#!/bin/sh
set -u

# Synchronise uniquement les commits de la branche principale.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
[ "$branch" = "main" ] || exit 0

if [ -z "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]; then
  printf '%s\n' 'Auto-push GitHub ignoré : connexion sécurisée indisponible.' >&2
  exit 0
fi

helper='!f() { printf "protocol=https\\nhost=github.com\\nusername=x-access-token\\npassword=%s\\n\\n" "$GITHUB_PERSONAL_ACCESS_TOKEN"; }; f'
if ! git -c credential.helper= -c credential.helper="$helper" push origin "$branch"; then
  printf '%s\n' 'Auto-push GitHub échoué ; le commit local est conservé.' >&2
fi
exit 0
